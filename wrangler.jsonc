{
  // This project deploys as a Cloudflare Worker with static assets
  // (`npx wrangler deploy`), NOT as a Pages project. Without this file
  // wrangler generates an assets-only config, which is why the API routes
  // did not exist and `worker.js` was rejected as a static upload.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jess-realty-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // directory "." keeps the site files where they already live at the repo
  // root; .assetsignore keeps source and docs out of the public upload.
  // run_worker_first matters: by default a request matching an uploaded file is
  // served straight from the edge and the Worker never runs, so the http->https
  // redirect and security headers were being skipped on every actual page and
  // only applied to /api/*. This routes everything through worker.js first,
  // which then serves the file via env.ASSETS.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Per-IP throttle on the public contact endpoint. Without it anyone can
  // script submissions, filling the database and burning the Web3Forms free
  // tier (250/month) - which would silently stop her real email notifications.
  "unsafe": {
    "bindings": [
      {
        "name": "CONTACT_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  },

  // `wrangler deploy` is declarative: it reconciles the Worker to this file
  // on every deploy. Bindings therefore have to live here, not in the
  // dashboard, or they get dropped on the next build.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jess-realty-leads",
      "database_id": "0993981e-2ebc-41ba-b367-efc3d9a5b542"
    }
  ],

  // Not secrets: the team domain and audience tag are public identifiers.
  // The audience tag is what pins an Access token to *this* application, so
  // a token minted for another app on the same team is rejected here.
  // worker.js verifies the signed Access token against these on every admin
  // request, so the API fails closed if the Access policy is ever removed.
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "kortumskingdom.cloudflareaccess.com",
    "CF_ACCESS_AUD": "1d803f7c90ddecc3a79b09f290ff8f48bb3f48382606a80913bcc136c3398751"
  }
}
