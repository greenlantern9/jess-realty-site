{
  // This project deploys as a Cloudflare Worker with static assets
  // (`npx wrangler deploy`), NOT as a Pages project. Without this file
  // wrangler generates an assets-only config, which is why the API routes
  // did not exist and `worker.js` was rejected as a static upload.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jess-realty-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // directory "." keeps the site files where they already live at the repo
  // root; .assetsignore keeps source and docs out of the public upload.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // `wrangler deploy` is declarative: it reconciles the Worker to this file
  // on every deploy. Bindings therefore have to live here, not in the
  // dashboard, or they get dropped on the next build.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jess-realty-leads",
      "database_id": "0993981e-2ebc-41ba-b367-efc3d9a5b542"
    }
  ]

  // Still to add before the admin board works (see ADMIN-SETUP.md):
  //
  //   "vars": {
  //     "CF_ACCESS_TEAM_DOMAIN": "<team>.cloudflareaccess.com",
  //     "CF_ACCESS_AUD": "<audience tag>"
  //   }
  //
  // Until these are set, /api/leads returns 503 by design rather than
  // serving client contact details unauthenticated.
}
